<!DOCTYPE hibernate-mapping PUBLIC 
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="spr.beans">
    <class name="FoodMenu" table="foodmenutable">
        <id name="orderId">
            <generator class="native"/>
        </id>
        <property name="foodName" column="FoodName"/>
        <property name="foodDescription" column="FoodDescription"/>
        <property name="patientId" column="patientId"/>
        <property name="cost" column="cost"/>
        <property name="availability" column="Availability"/>
        <property name="wardNo" column="WardNo"/>
        <property name="status" column="Status"/>
        
    </class>
    
</hibernate-mapping>